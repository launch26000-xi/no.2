# Copy to .env and fill in. Never commit .env.

# Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. For the snappiest phone replies you can try claude-haiku-5-5.
# CLAUDE_MODEL=claude-opus-5-5
# CALL_EFFORT=low

# Twilio (console.twilio.com -> Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public https address where this server runs, e.g. https://my-receptionist.onrender.com
PUBLIC_URL=

# Password for the /admin dashboard (username can be anything)
ADMIN_PASSWORD=

# Optional voice settings for Twilio ConversationRelay (leave blank for Twilio's default voice)
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=
